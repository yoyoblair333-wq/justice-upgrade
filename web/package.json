{
  "name": "justiceupgrade-web",
  "version": "0.1.0",
  "private": true,
  "description": "JusticeUpgrade web app: run a dispute on GenLayer studionet from the browser with two testnet burners, plus the live record of the deployed contract.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "live-check": "node scripts/live-check.mjs",
    "browser:install": "playwright install chromium",
    "test": "node --test --test-concurrency=1 test/unit.test.mjs test/browser.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/browser.test.mjs",
    "test:live": "node test/live.test.cjs",
    "test:live-write": "node test/live-write.test.cjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "playwright": "1.63.0"
  }
}
